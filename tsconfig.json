{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": [
      "DOM",
      "ES2020"
    ],
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
